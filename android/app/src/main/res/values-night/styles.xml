<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is on -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- PayTabs SDK Custom Dark Theme matching iOS configuration -->
    <style name="PaymentSdkTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Card background, text & primary colors -->
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#FFFFFF</item>
        
        <!-- PayTabs specific keys -->
        <item name="payment_sdk_primary_color">#FFFFFF</item>
        <item name="payment_sdk_button_background_color">#FFFFFF</item>
        <item name="payment_sdk_button_text_color">#000000</item>
        <item name="payment_sdk_text_color">#FFFFFF</item>
        <item name="payment_sdk_title_text_color">#FFFFFF</item>
        <item name="payment_sdk_card_background_color">#121212</item>
        <item name="payment_sdk_background_color">#000000</item>
        <item name="payment_sdk_input_info_text_color">#FFFFFF</item>
        <item name="payment_sdk_input_text_color">#FFFFFF</item>
        <item name="payment_sdk_hint_color">#808080</item>
    </style>
</resources>
